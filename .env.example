# clawd-JEV-trading machine configuration — copy to .env (NEVER commit .env)
# or export in your shell. Secrets are read from the environment at call
# time and never logged. All values below are placeholders.

# --- JEV brain (TypeSafe System One) ---------------------------------------
# Required for real paper runs. Omit it and use --dry-run-mock instead.
TYPESAFE_API_KEY=your-typesafe-key-here
# Model id for decisions (default: jev-latest)
LOBSTER_DECISION_MODEL=jev-latest
# Override the TypeSafe host if needed (default: https://api.typesafe.ai)
LOBSTER_TYPESAFE_URL=https://api.typesafe.ai
LOBSTER_TYPESAFE_TIMEOUT_S=30

# --- Venues -----------------------------------------------------------------
# Comma-separated subset of: jupiter, dflow, imperial, pumpfun, backpack
# jupiter  - keyless public Lite API quotes (works out of the box)
# dflow    - needs DFLOW_API_KEY; quote-only, read-only
# imperial - STUB in this scaffold (perps feed not wired; never offered)
# pumpfun  - token-vs-SOL venue: each mint in LOBSTER_PUMPFUN_TOKENS is quoted
#            as SOL per token via a keyless reference feed (indicative mid,
#            no order-book spread); BUY_<TAG>_PUMPFUN / SELL_<TAG>_PUMPFUN are
#            offered only for tokens with a fresh quote. Empty list (default)
#            -> venue unavailable, truthfully labeled. pump.fun lists NO
#            SOL/USDC spot market, so the venue-level quote never succeeds.
# backpack - Backpack Exchange public SOL/USDC order book (keyless);
#            quotes only, execution disabled - dry-run only
LOBSTER_VENUES=jupiter
# Comma-separated Solana mint addresses, e.g.
# LOBSTER_PUMPFUN_TOKENS=8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump
LOBSTER_PUMPFUN_TOKENS=
LOBSTER_PUMPFUN_QUOTE_URL=https://api.dexscreener.com
DFLOW_API_KEY=your-dflow-key-here
LOBSTER_JUPITER_URL=https://lite-api.jup.ag
LOBSTER_DFLOW_URL=https://quote-api.dflow.net
LOBSTER_BACKPACK_URL=https://api.backpack.exchange

# --- Market regime (CoinGecko) ----------------------------------------------
# Optional. Sent as the x-cg-demo-api-key header for higher rate limits.
# Without it the public endpoint is used; regime degrades to UNKNOWN on
# failure and the state labels it honestly.
COINGECKO_API_KEY=your-coingecko-key-here
COINGECKO_BASE_URL=https://api.coingecko.com

# --- Memory recall (Supermemory) --------------------------------------------
# Optional. Enables recall-before-JEV and write-after-outcome under the
# clawd-jev-trader container tag. Without it memory is disabled and the
# state labels it honestly. The key is never logged or persisted.
SUPERMEMORY_API_KEY=your-supermemory-key-here
SUPERMEMORY_BASE_URL=https://api.supermemory.ai

# --- Risk / sizing (paper) --------------------------------------------------
LOBSTER_TICKET_SOL=0.1        # fixed size per paper fill
LOBSTER_MAX_TICKET_SOL=1.0    # ticket must not exceed this
LOBSTER_QUOTE_SIZE_SOL=0.1    # size used when fetching venue quotes
LOBSTER_MAX_SLIPPAGE_BPS=50   # fills rejected when spread exceeds this
LOBSTER_FEE_BPS=25            # simulated fee per fill
LOBSTER_PAPER_START_USDC=1000 # paper portfolio starting balance
LOBSTER_QUOTE_STALE_S=300     # quotes older than this are treated as stale

# --- Misc -------------------------------------------------------------------
# Reserved for future live wiring; validated as a URL, unused by paper.
LOBSTER_RPC_URL=https://api.mainnet-beta.solana.com
# Where run reports go (default: ./runtime)
LOBSTER_STATE_DIR=runtime
# Runtime dependencies: none. clawd_jev is stdlib-only (urllib, argparse, json).
# Dev/test: stdlib unittest. No install needed beyond Python 3.10+.
